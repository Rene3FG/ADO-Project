# ── PostgreSQL (Supabase — conexión DIRECTA, no pooler)
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Asegúrate de usar el puerto 5432, NO el 6543 (pooler)
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-REF].supabase.co:5432/postgres

# ── Google Sheets
SPREADSHEET_ID=1bHoYKL5U14JfmhwwoLMHwzOtGbFbA_1sRF75P5G18sY
GOOGLE_CREDS_FILE=credentials/service_account.json

# ── Sync engine
SYNC_INTERVAL_SECONDS=120
CONFLICT_THRESHOLD_SECONDS=10

# ── Chatbot (LLM) — la llave real va solo en .env / variables de Render
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
